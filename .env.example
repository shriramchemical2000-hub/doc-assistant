# Primary hosted inference: Ollama runs in its own Docker container.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Gemini fallback. Not required for normal operation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local storage
DATABASE_PATH=data/assistant.db
UPLOAD_DIR=data/uploads

# Embeddings are computed on the server.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
DEFAULT_TOP_K=5
DEFAULT_MIN_SCORE=0.18
CHUNK_SIZE=900
CHUNK_OVERLAP=150
