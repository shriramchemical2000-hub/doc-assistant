# Hosted free deployment: add the Gemini key in Streamlit Community Cloud Secrets.
# Do not commit real API keys to this file or to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional local/Docker fallback. Docker Compose enables Ollama explicitly.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Local storage
DATABASE_PATH=data/assistant.db
UPLOAD_DIR=data/uploads

# Embeddings are computed on the app host.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
DEFAULT_TOP_K=5
DEFAULT_MIN_SCORE=0.18
CHUNK_SIZE=220
CHUNK_OVERLAP=40
